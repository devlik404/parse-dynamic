# One image supports JOB, HTTP preview, and scheduler-triggered dynamic parsing.
# SCHEDULER loads its parser schema from MSSQL per request and inserts into the
# target selected by the existing ParamParseFile configuration.
APP_MODE=JOB

# HTTP mode (`APP_MODE=HTTP`). These names and URL semantics match
# cashrecon-sch-parse-file-atm-bersama; this is not a direct S3/MinIO SDK connection.
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
MINIO_BASE_URL=http://sch-minio.reopsc:8080
MINIO_BUCKET_NAME=rsp-reopsc
MINIO_HTTP_TIMEOUT=5m
# Optional restriction for request final_minio_path; blank allows every safe path.
MINIO_PATH_PREFIX=
# Keep false only behind an authenticated trusted gateway, as in the reference setup.
PREVIEW_REQUIRE_AUTH=false
# Required and at least 32 bytes when PREVIEW_REQUIRE_AUTH=true.
PREVIEW_BEARER_TOKEN=
PREVIEW_DEFAULT_LIMIT=20
PREVIEW_MAX_LIMIT=100
PREVIEW_MAX_INPUT_BYTES=67108864
PREVIEW_MAX_REQUEST_BYTES=16384
PREVIEW_MAX_RESPONSE_BYTES=2097152
PREVIEW_MAX_VALUE_BYTES=1024
PREVIEW_REQUEST_TIMEOUT=30s
PREVIEW_MAX_CONCURRENCY=4
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Scheduler job mode (`APP_MODE=SCHEDULER`). It accepts the same request fields
# sent by sch-parse-file. It does not read PARSER_*, DB_COLUMNS, or
# DB_COLUMN_MAPPING: reader rules come from ParamReadFile* in the resolved target
# DB, while destination mappings remain in ParamParseFileMappingColumn.
# APP_MODE=SCHEDULER
# HTTP_ADDR=:8080
# MINIO_BASE_URL=http://sch-minio.reopsc:8080
# MINIO_BUCKET_NAME=rsp-reopsc
# MINIO_HTTP_TIMEOUT=10m
# MINIO_PATH_PREFIX=
# SS_RC_HOST=mssql-config.reopsc.svc
# SS_RC_PORT=1433
# SS_RC_USER=replace-from-secret
# SS_RC_PASSWORD=replace-from-secret
# SS_RC_DB_PARAM_ENGINE=ParamEngine
# SS_RC_DB_RECON_CONFIG=ReconConfig
# SCH_ENC_KEY=replace-from-secret
# SS_TR_PORT=1433
# DYNAMIC_DB_SSL_MODE=require
# DYNAMIC_DB_CONNECT_TIMEOUT=30s
# DYNAMIC_PARAM_SCHEMA=dbo
# DYNAMIC_EXISTING_PROFILE_TABLE=ParamParseFile
# DYNAMIC_EXISTING_MAPPING_TABLE=ParamParseFileMappingColumn
# DYNAMIC_PRODUCT_TABLE=Product
# DYNAMIC_READER_TABLE=ParamReadFile
# DYNAMIC_READER_COLUMN_TABLE=ParamReadFileColumn
# DYNAMIC_PASSWORD_DECRYPT_FUNCTION=fnDecrypt
# DYNAMIC_BATCH_SIZE=500
# DYNAMIC_BATCH_MAX_BYTES=67108864
# DYNAMIC_MAX_INPUT_BYTES=536870912
# DYNAMIC_MAX_RECORD_BYTES=8388608
# DYNAMIC_MAX_DOCUMENT_BYTES=536870912
# DYNAMIC_MAX_FIELDS=100000
# DYNAMIC_MAX_REQUEST_BYTES=16384
# DYNAMIC_REQUEST_TIMEOUT=10m
# DYNAMIC_MAX_CONCURRENCY=4
# DYNAMIC_REQUIRE_AUTH=false
# DYNAMIC_BEARER_TOKEN=
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=15m
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=30s

# Universal parser configuration. JOB and HTTP read this snapshot once.
# SCHEDULER ignores these PARSER_* values.
# HTTP ignores INPUT_PATH/FILE_PATTERN plus all DB_* and ERROR_* settings;
# INPUT_SKIP_EMPTY_LINE still controls decoder behavior.

# Input: INPUT_PATH may be one regular file or a directory.
INPUT_PATH=/data/input
FILE_PATTERN=*.txt
INPUT_SKIP_EMPTY_LINE=true

# Decoder: DELIMITED | CSV | TSV | FIXED_WIDTH | JSON | XML | RAW | TEXT |
# HTML | HTM | PDF | XLS | XLSX | SECTIONED_DELIMITED
PARSER_FILE_TYPE=DELIMITED
PARSER_DELIMITER=|
PARSER_HAS_HEADER=false
PARSER_COLUMNS=transaction_id,transaction_date,bank,amount
PARSER_TYPES=string,date,string,decimal
PARSER_MAPPING=0:transaction_id,1:transaction_date,2:bank,3:amount

# Type conversion and common transformations.
PARSER_DATE_FORMAT=20060102
PARSER_DATETIME_FORMAT=2006-01-02T15:04:05Z07:00
PARSER_TIMEZONE=Asia/Jakarta
PARSER_TRIM_SPACE=true
PARSER_NULL_IF_EMPTY=true
PARSER_UPPERCASE_FIELDS=bank
PARSER_LOWERCASE_FIELDS=
PARSER_DEFAULT_VALUES={"bank":"UNKNOWN"}
PARSER_REQUIRED_FIELDS=transaction_id,transaction_date,amount
PARSER_ALLOW_EXTRA_COLUMNS=false
PARSER_MAX_RECORD_BYTES=1048576
# Random-access input/unpacked-document ceiling for PDF, XLS, and XLSX.
PARSER_MAX_DOCUMENT_BYTES=67108864
PARSER_MAX_FIELDS=10000

# XLS/XLSX worksheet name or zero-based index. HTML table index is zero-based.
PARSER_SPREADSHEET_SHEET=0
PARSER_HTML_TABLE_INDEX=0

# Optional ordered field rules. Operations: TRIM, UPPERCASE, LOWERCASE,
# REPLACE, SUBSTRING, DEFAULT_VALUE, NULL_IF_EMPTY.
PARSER_TRANSFORMS_JSON=[]

# SECTIONED_DELIMITED example for generic control/header/data/footer files.
# Record and field indexes are zero-based. Codes are configuration, not parser code.
# PARSER_RECORD_TYPE_INDEX=0
# PARSER_SECTION_KEY_INDEX=1
# PARSER_FILE_HEADER_CODE=RH
# PARSER_SECTION_HEADER_CODE=SH
# PARSER_DATA_CODE=SB
# PARSER_SECTION_FOOTER_CODE=SF
# PARSER_FILE_FOOTER_CODE=RF
# PARSER_DYNAMIC_HEADER_START_INDEX=2
# PARSER_DATA_START_INDEX=2
# PARSER_DUPLICATE_HEADER_POLICY=SUFFIX_INDEX

# FIXED_WIDTH example. Starts in ENV are 1-based and normalized internally.
# PARSER_FIXED_WIDTH_UNIT=BYTE
# PARSER_FIXED_WIDTH_FIELDS=transaction_id:1:6:string,transaction_date:7:8:date,bank:15:3:string,amount:18:12:decimal

# JSON example. Mode: AUTO | SINGLE | ARRAY | NDJSON. JSON mapping takes
# precedence over PARSER_MAPPING; JSON_RECORD_PATH is optional.
# PARSER_JSON_MODE=AUTO
# PARSER_JSON_RECORD_PATH=transactions
# PARSER_JSON_MAPPING=transaction.id:transaction_id,transaction.date:transaction_date,transaction.bank:bank,transaction.amount:amount

# XML example. Paths are simple streaming element paths, not full XPath.
# PARSER_XML_RECORD_PATH=/transactions/transaction
# PARSER_XML_MAPPING=id:transaction_id,date:transaction_date,bank:bank,amount:amount

# HTML/HTM reads rows from one table. PARSER_HAS_HEADER controls whether the
# first non-empty row supplies selector names.
# PARSER_FILE_TYPE=HTML
# PARSER_HTML_TABLE_INDEX=0

# XLS/XLSX reads one worksheet by name or zero-based index.
# PARSER_FILE_TYPE=XLSX
# PARSER_SPREADSHEET_SHEET=Transactions
# PARSER_HAS_HEADER=true

# PDF emits one record per page from the embedded text layer. Scanned pages
# require OCR and are returned as PDF_PAGE_HAS_NO_TEXT.
# PARSER_FILE_TYPE=PDF
# PARSER_COLUMNS=page_number,page_text
# PARSER_TYPES=int64,string
# PARSER_MAPPING=page:page_number,text:page_text

# Database: postgres/pgx | mysql | sqlserver. DB_DSN can replace the individual
# connection fields. Mapping direction is canonical_field:database_column.
DB_DRIVER=postgres
DB_DSN=
DB_HOST=localhost
DB_PORT=5432
DB_USER=parser_job
DB_PASSWORD=
DB_NAME=reconciliation
DB_SCHEMA=public
DB_TABLE=transactions
DB_COLUMNS=transaction_id,transaction_date,bank,amount
DB_COLUMN_MAPPING=transaction_id:transaction_id,transaction_date:transaction_date,bank:bank,amount:amount
DB_BATCH_SIZE=1000
DB_BATCH_MAX_BYTES=67108864
# Local-only example. Production should use require/verify settings or a DB_DSN
# with CA verification appropriate for the selected driver.
DB_SSL_MODE=disable
DB_CONNECT_TIMEOUT=30s

# STRICT rolls the whole input file back after one rejected record. PARTIAL
# commits valid records and requires a durable ERROR_OUTPUT_PATH.
ERROR_MODE=STRICT
ERROR_OUTPUT_PATH=/data/errors/rejected-records.jsonl
ERROR_MAX_COUNT=0




# # Runtime HTTP parser ATM Bersama.
# # MinIO values use the cashrecon job HTTP-gateway contract. Runtime reads
# # follow HEAD metadata -> streaming GET -> HEAD identity verification.
# APP_MODE=HTTP
# HTTP_ADDR=:8083

# MINIO_BASE_URL=http://sch-minio.reopsc:8080
# MINIO_BUCKET_NAME=rsp-reopsc
# MINIO_HTTP_TIMEOUT=5m
# # Blank preserves the reference job behavior: every validated path in the
# # configured bucket may be requested. Set a common root to restrict it.
# MINIO_PATH_PREFIX=

# # The reference endpoint has no application bearer token. Keep this false only
# # when access is already protected by the internal gateway/NetworkPolicy.
# PREVIEW_REQUIRE_AUTH=false
# PREVIEW_BEARER_TOKEN=
# PREVIEW_DEFAULT_LIMIT=20
# PREVIEW_MAX_LIMIT=100
# PREVIEW_MAX_INPUT_BYTES=67108864
# PREVIEW_MAX_REQUEST_BYTES=16384
# PREVIEW_MAX_RESPONSE_BYTES=2097152
# PREVIEW_MAX_VALUE_BYTES=1024
# PREVIEW_REQUEST_TIMEOUT=30s
# PREVIEW_MAX_CONCURRENCY=4

# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=10s

# # Dynamic RH/SH/SB/SF/RF parser. Codes are ENV-driven, not hardcoded in Go.
# INPUT_SKIP_EMPTY_LINE=true
# PARSER_FILE_TYPE=SECTIONED_DELIMITED
# PARSER_DELIMITER="|"
# PARSER_HAS_HEADER=false
# PARSER_COLUMNS=record_type,section_key,payload
# PARSER_TYPES=string,string,json
# PARSER_MAPPING=record_type:record_type,section_key:section_key,payload:payload

# PARSER_RECORD_TYPE_INDEX=0
# PARSER_SECTION_KEY_INDEX=1
# PARSER_FILE_HEADER_CODE=RH
# PARSER_SECTION_HEADER_CODE=SH
# PARSER_DATA_CODE=SB
# PARSER_SECTION_FOOTER_CODE=SF
# PARSER_FILE_FOOTER_CODE=RF
# PARSER_DYNAMIC_HEADER_START_INDEX=2
# PARSER_DATA_START_INDEX=2
# PARSER_DUPLICATE_HEADER_POLICY=SUFFIX_INDEX

# PARSER_TRIM_SPACE=true
# PARSER_NULL_IF_EMPTY=true
# PARSER_ALLOW_EXTRA_COLUMNS=false
# PARSER_MAX_RECORD_BYTES=1048576
# PARSER_MAX_FIELDS=10000
